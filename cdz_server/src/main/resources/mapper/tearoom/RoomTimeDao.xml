<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sqx.modules.tearoom.dao.RoomTimeDao">

    <select id="selectByGoodsIdDateAndTimes" resultType="com.sqx.modules.tearoom.entity.RoomTime">
        SELECT * FROM room_time
        WHERE
        goods_id = #{goodsId}
        AND room_date = #{roomDate}
        AND room_time IN
        <foreach collection="roomTimeList" item="time" open="(" separator="," close=")">
            #{time}
        </foreach>
        ORDER BY room_time ASC
    </select>

</mapper>